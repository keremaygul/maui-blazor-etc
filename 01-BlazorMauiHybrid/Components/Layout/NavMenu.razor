@*
    📝 BLAZOR DERSİ - NAV MENU:
    
    <NavLink> component'i, Blazor'un built-in navigation link'idir.
    - Aktif sayfada otomatik "active" CSS class'ı ekler
    - Match="NavLinkMatch.All" → URL tam eşleşmeli olmalı ("/" için gerekli)
    - Varsayılan Match → Prefix-based eşleşme
    
    Bu component MainLayout.razor tarafından include edilir.
*@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">📦 StockTracker</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Products
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="scanner">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Scanner
            </NavLink>
        </div>
    </nav>
</div>
